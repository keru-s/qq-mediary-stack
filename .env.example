# ════════════════════════════════════════════════════════════════
# 影视自动化部署配置。极空间：在 Compose 面板「新增项目」时选择的
# 「存储位置」文件夹就是数据根目录，./ 相对路径自动落在它下面，
# 不需要手动填任何路径。
# ════════════════════════════════════════════════════════════════

# ---- 必填：DeepSeek（OpenAI 兼容）给 Mediary Scout 的获取 agent 用 ----
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_ID=deepseek-chat
AGENT_MODEL_API_KEY=sk-填你的DeepSeek密钥

# ---- 必填：agent API 的 Bearer token（QQ 机器人壳和 web 共用）----
# 生成方法：openssl rand -hex 32
MEDIA_TRACK_AGENT_TOKEN=

# ---- QQ 机器人（不用机器人可留空，up 时不加 --profile bot 即可）----
# 在 QQ 开放平台 https://q.qq.com 创建机器人后获得
QQ_BOT_APPID=
QQ_BOT_APPSECRET=
# 允许使用机器人的 QQ 用户 openid，逗号分隔。
# openid 获取方式：先随便给机器人发条私聊，看 qqbot 容器日志里
# 「忽略非白名单用户 <openid> 的消息」一行，把该 openid 填进来重启。
ALLOWED_OPENIDS=

# ---- pansou 镜像（ghcr 拉不动时换国内镜像）----
# 官方：PANSOU_IMAGE=ghcr.io/fish2018/pansou-web:latest
# 国内镜像候选：
PANSOU_IMAGE=ghcr.nju.edu.cn/fish2018/pansou-web:latest

# ---- Docker Hub 镜像源（大陆建议填；境外留空）----
# 已实测可用：docker.1ms.run / dockerproxy.net / docker.m.daocloud.io / hub.rat.dev
# 影响 postgres、openlist 和 web 构建阶段的 node 基础镜像
DOCKER_MIRROR=

# ---- 本机构建 web 时的 npm 源（大陆建议）----
NPM_REGISTRY=https://registry.npmmirror.com

# ---- web 对外端口（容器内固定 3000）----
WEB_PORT=3300

# ---- OpenList / STRM 自动同步 ----
# OpenList 管理员密码（首次启动后在容器日志里能看到初始密码，
# 或在 OpenList 网页后台「个人资料」里改一个，填到这里）
OPENLIST_USER=admin
OPENLIST_PASSWORD=
# Strm 驱动在 OpenList 里的挂载路径（加 Strm 驱动时自己定的挂载路径）
STRM_PATH=/strm
# 兜底扫描间隔秒数（默认 6 小时；QQ 点播完成时会即时触发一次，不用等兜底。
# 遍历会调夸克 API，不建议低于 600）
SCAN_INTERVAL_S=21600

# ---- 可选 ----
# 有自己的 TMDB v4 read token 可填；留空走作者内置代理
TMDB_READ_TOKEN=
# 反代/隧道下域名与内部不一致时填（构建期烘焙，改后需 --build 重建）
# MEDIA_TRACK_ALLOWED_ORIGINS=
# Cloudflare Tunnel（一般用不到，极空间局域网直连即可）
TUNNEL_TOKEN=
